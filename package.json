{
  "name": "playwright-ecommerce-automation",
  "version": "1.0.0",
  "type": "module",
  "description": "End-to-end Playwright test automation framework for an e-commerce site — page object architecture, worker-isolated authentication, API-level security testing, visual regression, WCAG 2.1 AA accessibility auditing, and dual CI/CD (GitHub Actions + Jenkins) with Allure reporting.",
  "main": "index.js",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:debug": "playwright test --debug",
    "test:chromium": "playwright test --project=chromium",
    "test:smoke": "playwright test --grep @smoke",
    "test:regression": "playwright test --grep @regression",
    "test:security": "playwright test --grep @security",
    "test:report": "playwright show-report",
    "allure:generate": "allure generate allure-results --clean -o allure-report",
    "allure:open": "allure open allure-report",
    "codegen": "playwright codegen $BASE_URL",
    "lint": "eslint .",
    "format": "prettier --check ."
  },
  "keywords": [],
  "author": "Abdelrahman Kamel",
  "license": "ISC",
  "engines": {
    "node": "^20.19.0 || ^22.13.0 || ^23.5.0 || >=24.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@faker-js/faker": "^10.5.0",
    "@playwright/test": "^1.61.0",
    "@types/node": "^26.0.0",
    "allure-commandline": "^2.34.0",
    "allure-playwright": "^3.0.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.9.0",
    "eslint-plugin-playwright": "^2.11.0",
    "globals": "^17.11.0",
    "prettier": "^3.9.6"
  }
}
